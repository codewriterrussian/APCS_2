   "outputs": [],
   "source": [
    "sides = list(map(int,input().split()))\n",
    "sides.sort()\n",
    "\n",
    "a,b,c = sides\n",
    "print(*sides)\n",
    "\n",
    "if a+b <= c:\n",
    "    print(\"No\")\n",
    "elif a*a+b*b == c*c:\n",
    "    print(\"Right\")\n",
    "elif a*a+b*b < c*c:\n",
    "    print(\"Obtuse\")\n",
    "elif a*a+b*b > c*c:\n",
    "    print(\"Acute\")"
   ]
  },
